# 仮想環境・キャッシュ
.venv/
venv/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.cache/
/cache/

# 認証クッキー（リポジトリへコミットしない）
youtube_cookie.txt
youtube_cookies.txt
nico_cookies.txt
data/youtube_cookies.runtime.txt

# 資格情報・シークレット（リポジトリへコミットしない）
client_secrets.json
token.json
**/credentials*.json
**/client_secret*.json

# ローカル設定・秘密情報
.env
*.log
data/momoka_gui.txt
data/momoka_gui.log
.cursor/

# ホスト Electron GUI
gui-electron/node_modules/
gui-electron/dist/


# ビルド成果物
/dist/
/build/
third_party/bgutil-ytdlp-pot-provider/server/node_modules/
third_party/bgutil-ytdlp-pot-provider/server/build/
*.exe
*.bin

# ランタイム SQLite（設定・状態）
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# 旧ルート設定（使用しない・誤コミット防止）
/config.yaml
configs/*_config.yaml
!configs/*_config.default.yaml
# メディアダウンローダー allowlist（ランタイムコピー。*.default.json はコミット可）
configs/media_downloader_allowlist.json
!configs/media_downloader_allowlist.default.json
# /download_* 一時配信用コピー
temp_media_download/
temp_media_share/
/models/image-models/modelA/
