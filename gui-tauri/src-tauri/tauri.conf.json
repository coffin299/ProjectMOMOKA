{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "momoka-host-gui",
  "version": "1.0.0",
  "identifier": "com.momoka.host-gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MOMOKA",
        "width": 1280,
        "height": 800,
        "backgroundColor": [30, 31, 34, 255]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
